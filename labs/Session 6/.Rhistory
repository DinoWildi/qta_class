flesch_us <- corp_us |>
textstat_readability(measure = "Flesch.Kincaid")
dalechall_us <- corp_us |>
textstat_readability(measure = "Dale.Chall")
flesch_us <- corp_us |>
textstat_readability(measure = "Flesch.Kincaid")
dalechall_us <- corp_us |>
textstat_readability(measure = "Dale.Chall")
read_us <- left_join(flesch_us, dalechall_us)
# Check if it worked:
head(read_us)
ggplot(read_us) +
geom_point(aes(
x = Flesch.Kincaid,
y = Dale.Chall
)) +
geom_smooth(aes(
x = Flesch.Kincaid,
y = Dale.Chall
),
method = "lm")
