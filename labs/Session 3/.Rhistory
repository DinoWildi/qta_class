sentences_21 <- corpus_reshape(speeches_21,
to = "sentences")
ntoken(sentences_21) |>
max()
toks_21 <- tokens(speeches_21,
remove_punct = T) |>
tokens_remove(stopwords("en"))
ntoken(toks_21)
toks_21 <- tokens_compound(toks_21,
pattern = phrase("United States"))
tokens_match(toks_21, c("United_Stated"))
tokens_match(toks_21, c("United_States"))
kwic(toks_21, "United_States")
dfmat <- dfm(toks_21)
head(dfmat)
topfeatures(dfmat, n = 10)
dfmat <- dfm(toks_21) |>
dfm_trim(min_termfreq = 10)
head(dfmat)
topfeatures(dfmat, n = 10)
dfmat_all <- dfm(speeches) |>
dfm_trim(min_termfreq = 10)
dfmat_all <- speeches |>
tokens(remove_punct = T) |>
tokens_remove(stopwords("en")) |>
tokens_compound(
pattern = phrase("United States")
) |>
dfm() |>
dfm_trim(min_termfreq = 10)
topfeatures(dfmat_all, n = 10)
