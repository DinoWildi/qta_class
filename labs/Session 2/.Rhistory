mutate(avg_speed = km/hours)
flightdata <- flightdata |>
mutate(avg_speed = km/hours)
summary(select(flightdata, km, hours, avg_speed))
summary(flightdata$month)
View(flights)
flightdata <- flightdata |>
mutate(season = case_when(
month <= 2 | month == 12 ~ "Winter",
month >= 3 & month <= 5 ~ "Spring",
month >= 6 & month <= 8 ~ "Summer",
month >= 9 & month <= 11 ~ "Autumn"
))
table(flightdata$season)
table(flightdata$season, flightdata$month)
summary(flightdata$arr_delay)
delays <- flightdata |>
group_by(season) |>
summarise(mean_arr_del = mean(arr_delay),
mean_dep_del = mean(dep_delay))
flightdata
